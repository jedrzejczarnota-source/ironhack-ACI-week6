    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "appstore-competitor",
              "name": "competitor",
              "value": "={{ $('Competitor Input').first().json.competitor }}",
              "type": "string"
            },
            {
              "id": "appstore-count",
              "name": "appStoreResultCount",
              "value": "={{ $json.resultCount ?? 0 }}",
              "type": "number"
            },
            {
              "id": "appstore-results",
              "name": "appStoreResults",
              "value": "{{\n  ($json.results ?? (typeof $json.data === 'string' ? JSON.parse($json.data).results : []) ?? []).map(app => {\n    const releaseMs = new Date(app.releaseDate).getTime();\n    const updateMs = new Date(app.currentVersionReleaseDate).getTime();\n    const nowMs = Date.now();\n    const ageYears = Math.max(0.1, (nowMs - releaseMs) / (1000 * 60 * 60 * 24 * 365.25));\n    const daysSinceUpdate = Math.max(0, Math.floor((nowMs - updateMs) / (1000 * 60 * 60 * 24)));\n    const ratingsPerYear = Math.round((app.userRatingCount ?? 0) / ageYears);\n\n    return {\n      trackName: app.trackName,\n      developer: app.artistName,\n      primaryGenre: app.primaryGenreName,\n      averageUserRating: Number((app.averageUserRating ?? 0).toFixed(2)),\n      userRatingCount: app.userRatingCount ?? 0,\n      ratingsPerYearVelocity: ratingsPerYear,\n      daysSinceLastUpdate: daysSinceUpdate,\n      liveOpsCadenceSignal: daysSinceUpdate <= 21 ? \"Active LiveOps (<=21d)\" : (daysSinceUpdate <= 60 ? \"Moderate (22-60d)\" : \"Maintenance / Slow (>60d)\"),\n      firstReleaseDate: app.releaseDate ? app.releaseDate.slice(0, 10) : \"Unknown\",\n      lastUpdateDate: app.currentVersionReleaseDate ? app.currentVersionReleaseDate.slice(0, 10) : \"Unknown\",\n      currentVersion: app.version\n    };\n  })\n}}",
              "type": "array"
            },
            {
              "id": "4c55b0bc-c65f-415a-8f6b-20638b9e14a3",
              "name": "appStoreStatus",
              "value": "={{ $json.error ? \"failed\" : \"ok\" }}",
              "type": "string"
            },
            {
              "id": "01a68566-b5bb-4cf4-8cd8-8a530144314e",
              "name": "appStoreError",
              "value": "={{ $json.error?.message ?? \"\" }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "ignoreConversionErrors": true
        }
      },
